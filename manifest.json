{
  "manifest_version": 3,
  "name": "CSE Radar",
  "version": "0.1.0",
  "description": "Discover tech events, save opportunities, and track registration deadlines in your calendar.",
  "permissions": ["storage", "alarms", "notifications"],
  "action": {
    "default_title": "Open CSE Radar",
    "default_icon": {"16": "icons/radar-16.png", "32": "icons/radar-32.png"}
  },
  "icons": {"16": "icons/radar-16.png", "32": "icons/radar-32.png", "48": "icons/radar-48.png", "128": "icons/radar-128.png"},
  "background": {"service_worker": "background.js"}
}
